  ],
  "cues": [
    {
      "start_ms": 5472,
      "end_ms": 7407,
      "text": "В мире, где бродят Призраки,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "eee76727b4e44c0ea0aa060458de35d5",
      "exaggeration": 0.5
    },
    {
      "start_ms": 7707,
      "end_ms": 9409,
      "text": "остальные выживают, а я зарабатываю.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2037678e74ed4e368e49e0e5150811a8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 9743,
      "end_ms": 11478,
      "text": "Будь то забытая винтажная кола",
      "dub_text": "",
      "character": "гг",
      "cue_id": "1a5ee1dd044541789772311ef2690d8b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 11711,
      "end_ms": 13480,
      "text": "или мясо исчезнувшей породы,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "033ab209519146dcbbdd51ea8acb7d06",
      "exaggeration": 0.5
    },
    {
      "start_ms": 14147,
      "end_ms": 15582,
      "text": "были бы деньги",
      "dub_text": "",
      "character": "гг",
      "cue_id": "1222cda6813c4a639f4eb8fdabfe6750",
      "exaggeration": 0.5
    },
    {
      "start_ms": 15849,
      "end_ms": 17584,
      "text": "даже Призрак С-класса",
      "dub_text": "",
      "character": "гг",
      "cue_id": "560648574dac4967b3dfad5639aa1c8c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 17951,
      "end_ms": 18184,
      "text": "окажется окажется в в менюменю моей таверны.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "86a143b63e8d4bec95937afdb4fa507f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 18184,
      "end_ms": 20186,
      "text": "окажется в меню моей таверны.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "b8595366007a4173ad882e9ce9f7e8c4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 22022,
      "end_ms": 22722,
      "text": "Оксгрим,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "6e4f6eaf5946452eb9494e26e73478b4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 22789,
      "end_ms": 23790,
      "text": "к нам идут гости.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "319190bd40b345ada6ae17c77422b362",
      "exaggeration": 0.5
    },
    {
      "start_ms": 23790,
      "end_ms": 24691,
      "text": "Иди встречай.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "4e633302cbf8431c842b0e012d0191d6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 25425,
      "end_ms": 25925,
      "text": "И помни,  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "554555277ec446929536e5a5f3b6dca0",
      "exaggeration": 0.5
    },
    {
      "start_ms": 26593,
      "end_ms": 27694,
      "text": "улыбайся.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "aafe0ecdd9b14626994ccfcc2cc258b8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 28561,
      "end_ms": 29029,
      "text": "Да,  ",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "ccd00d096e0e40dabdc8885a6c8411b4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 29029,
      "end_ms": 30030,
      "text": "босс.  ",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "6eddac617a2e4baa81676af03d3f72ad",
      "exaggeration": 0.5
    },
    {
      "start_ms": 34968,
      "end_ms": 35702,
      "text": "Не оглядываться!  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "3b5b825301b54ad2b88b638a42ae0f6b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 35702,
      "end_ms": 36369,
      "text": "Бегом!  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "c8a61b8a23e441b599151553ebeca076",
      "exaggeration": 0.5
    },
    {
      "start_ms": 40440,
      "end_ms": 42909,
      "text": "Капитан, я больше не могу!  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "0dc1f85c9b0a4486945f1fbda608289f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 44344,
      "end_ms": 45345,
      "text": "Вставай!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "6ec25498c02e40b9b46fd732422ee010",
      "exaggeration": 0.5
    },
    {
      "start_ms": 45345,
      "end_ms": 46880,
      "text": "Это Призрак А-класса, Чёрный Козёл!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "1e193fdcb20047c4a5075dda7c12c19b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 46880,
      "end_ms": 48648,
      "text": "Он пожирает всё.  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "03909626b0f64660905e48b25f0f322f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 48681,
      "end_ms": 50116,
      "text": "Хочешь стать его ужином?  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "169c1d26c62e4ca3bbae2bbac9c868b5",
      "exaggeration": 0.5
    },
    {
      "start_ms": 50550,
      "end_ms": 53653,
      "text": "Три Стража С-класса на Призрака  А-класса? ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "bf7037b9a6834cceac9ddc9309f186de",
      "exaggeration": 0.5
    },
    {
      "start_ms": 53686,
      "end_ms": 55121,
      "text": "Мы трупы!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "cda1a20ef28f4256a1c421745f69b726",
      "exaggeration": 0.5
    },
    {
      "start_ms": 55388,
      "end_ms": 55989,
      "text": "Ленси!",
      "dub_text": "Ленси!",
      "character": "командир",
      "cue_id": "bf621df3bc87413a836f8c05d6b2374f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 56189,
      "end_ms": 56923,
      "text": "Тащи его, и бежим!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "5adb32edc9a341eb82a1786912319216",
      "exaggeration": 0.5
    },
    {
      "start_ms": 61428,
      "end_ms": 62262,
      "text": "Он ускоряется!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "48054fc70a98491ebba035c00cca05ee",
      "exaggeration": 0.5
    },
    {
      "start_ms": 63196,
      "end_ms": 64197,
      "text": "ноги не держат!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "261534b3a173437a94a97e117328af0a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 64230,
      "end_ms": 65765,
      "text": "Кидай все разрывные!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "25cd81000ffa4d9d8c2fda49b591af16",
      "exaggeration": 0.5
    },
    {
      "start_ms": 65765,
      "end_ms": 67600,
      "text": "Надо задержать его хоть на секунду!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "3236373b82694ac2ac48022e0046b8ce",
      "exaggeration": 0.5
    },
    {
      "start_ms": 79446,
      "end_ms": 80313,
      "text": "Бесполезно!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "92a2570bbcfe4eaa8e2bf0d114313c11",
      "exaggeration": 0.5
    },
    {
      "start_ms": 80380,
      "end_ms": 81815,
      "text": "Ему плевать на атаки.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "70bfdb5881d54453a9b39ee59449f06f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 81815,
      "end_ms": 82649,
      "text": "Мы обречены.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "3a5a4aca70fa49949ed080c587876e8c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 82649,
      "end_ms": 84551,
      "text": "Вот и всё.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "68a2b75ce0b5489c9d3364289961b2e4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 84584,
      "end_ms": 84951,
      "text": "Капитан!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "ca2a39aad8854a8191346db6b9dcdbef",
      "exaggeration": 0.5
    },
    {
      "start_ms": 84951,
      "end_ms": 85685,
      "text": "Смотрите вперёд!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "d9babccc264845288b781f959ffe9f08",
      "exaggeration": 0.5
    },
    {
      "start_ms": 85752,
      "end_ms": 86753,
      "text": "Там здание!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "83d8b7cb7cea44588a38683361c6f0e9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 88354,
      "end_ms": 90857,
      "text": "Откуда здесь здание?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "91cd72df75684191bb7221976806e1b7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 93960,
      "end_ms": 95728,
      "text": "Таверна «Подземный мир»?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "a8df5789c93041f58808bae4d4464f86",
      "exaggeration": 0.5
    },
    {
      "start_ms": 96162,
      "end_ms": 96863,
      "text": "У меня глюки?  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "923d7ab3e426479faed04fb291257e44",
      "exaggeration": 0.5
    },
    {
      "start_ms": 97530,
      "end_ms": 99265,
      "text": "Таверна за периметром?",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "6f958084b445472b8056f8e7620ac8e2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 99365,
      "end_ms": 100533,
      "text": "Плевать, что это!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "d9c777fc1b3c43e4b77773351d2518d5",
      "exaggeration": 0.5
    },
    {
      "start_ms": 100700,
      "end_ms": 103403,
      "text": "Лучше рискнуть, чем пойти на корм!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "92362cbb034f497680f755cedcadfed3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 103570,
      "end_ms": 104471,
      "text": "Вперёд!  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "02d0968b72c4422fb8a4df5785bd7a54",
      "exaggeration": 0.5
    },
    {
      "start_ms": 105572,
      "end_ms": 105905,
      "text": "Все внутрь!  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "e6927c1bcd3946b5a99e5949db72a6de",
      "exaggeration": 0.5
    },
    {
      "start_ms": 106206,
      "end_ms": 106906,
      "text": "Живо!  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "78ffd86906784b0ba6e171e0bbb005e2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 114547,
      "end_ms": 115348,
      "text": "чорт,",
      "dub_text": "",
      "character": "командир",
      "cue_id": "ccdb623acb27468284469d2a0e5d19d9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 115748,
      "end_ms": 117283,
      "text": "он лезет за нами.",
      "dub_text": "",
      "character": "командир",
      "cue_id": "6d401862e8d14d92b008facd7097ed9f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 117817,
      "end_ms": 119352,
      "text": "Пожиратель А-класса  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "e38fb7cf0b214907afc441e432c49da7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 119652,
      "end_ms": 121121,
      "text": "Нам конец.  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "bc2d30e144a2427bb42027a6090ee42a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 126960,
      "end_ms": 128728,
      "text": "Почему... почему он не заходит?",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "b46ea0db8e644c8ba9372aac810b5f32",
      "exaggeration": 0.5
    },
    {
      "start_ms": 128728,
      "end_ms": 130563,
      "text": "Он боится этой таверны?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "29c62df3ab2f4cadabc78bbdd5920f71",
      "exaggeration": 0.5
    },
    {
      "start_ms": 132398,
      "end_ms": 132866,
      "text": "Ребята,",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "a1da6b9eee544863b1567d7c2cbf2188",
      "exaggeration": 0.5
    },
    {
      "start_ms": 133199,
      "end_ms": 134200,
      "text": "посмотрите на полки",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "c8d46605437f4f968d69bad9d89d612c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 139772,
      "end_ms": 140607,
      "text": "Быть не может!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "56d9c0225d364009bbbe3a648ee65d70",
      "exaggeration": 0.5
    },
    {
      "start_ms": 140773,
      "end_ms": 141141,
      "text": "В Пустоши такого давно нет.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "4d51bd2a8ce64982bb7864d6aec48611",
      "exaggeration": 0.5
    },
    {
      "start_ms": 142976,
      "end_ms": 144410,
      "text": "Люди голодают.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "a67d3007e674406b91d5431d52cca431",
      "exaggeration": 0.5
    },
    {
      "start_ms": 144444,
      "end_ms": 147680,
      "text": "На базе Ковчег котлеты из жуков - сокровище.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "56239960a84845069ab8ed780b7a9936",
      "exaggeration": 0.5
    },
    {
      "start_ms": 148781,
      "end_ms": 149349,
      "text": "Откуда здесь чипсы?",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "c8c8c79d8ec34daca58a03db01bf0366",
      "exaggeration": 0.5
    },
    {
      "start_ms": 149849,
      "end_ms": 152952,
      "text": "И даже запечатанный рис!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "9ea12f991ab244918e5838ca1ecf5613",
      "exaggeration": 0.5
    },
    {
      "start_ms": 153153,
      "end_ms": 156089,
      "text": "Упаковка совсем новая.",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "3d9823173ccc48a9b7fafa902ef830b1",
      "exaggeration": 0.5
    },
    {
      "start_ms": 156089,
      "end_ms": 157657,
      "text": "Ни царапин, ни пыли. ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "3c77bb3b1a1c40378cf890b101392884",
      "exaggeration": 0.5
    },
    {
      "start_ms": 157790,
      "end_ms": 158658,
      "text": "Это странно... очень странно.  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "8f972310a4024038bd35ee4c4c1de33d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 160226,
      "end_ms": 162762,
      "text": "Это жутче того призрака А-класса.",
      "dub_text": "",
      "character": "командир",
      "cue_id": "b2bb58cfa36f4822b3bf9233469c663f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 162762,
      "end_ms": 163863,
      "text": " А что, если мы сейчас",
      "dub_text": "",
      "character": "командир",
      "cue_id": "060651b319ca4c4eb66f9c868b759f0e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 163863,
      "end_ms": 165632,
      "text": " в какой-то иллюзии?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "182968e95e8c4ed2b57ab74a7d00c9ea",
      "exaggeration": 0.5
    },
    {
      "start_ms": 165765,
      "end_ms": 166900,
      "text": "Может, проверим?",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "8714d128269e4049990845751c84b44e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 166900,
      "end_ms": 168535,
      "text": "Настоящее это или нет? ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "bc527be6c5104f86b911824261e33f59",
      "exaggeration": 0.5
    },
    {
      "start_ms": 168701,
      "end_ms": 170270,
      "text": "Вдруг это можно есть.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "d1c35af7f1b94db59e6832be2ce243b8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 172705,
      "end_ms": 175441,
      "text": "Землетрясение? Откуда оно здесь?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "aeef6c7fde4e424487e15f517b92d523",
      "exaggeration": 0.5
    },
    {
      "start_ms": 175542,
      "end_ms": 176976,
      "text": "Нет, это не землетрясение.  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "cac665530f97423fa453cde346bd2c42",
      "exaggeration": 0.5
    },
    {
      "start_ms": 177110,
      "end_ms": 178144,
      "text": "Это та тварь!  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "924ca73a5ff64a429869bfd734e89a66",
      "exaggeration": 0.5
    },
    {
      "start_ms": 178144,
      "end_ms": 179412,
      "text": "Она ломится сюда!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "d59d2f2e25e94167bc871f84033f6e3b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 190323,
      "end_ms": 192625,
      "text": "Чорт, стены не выдержат!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "b173fe372c3542d4918ccfbb32288dc6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 192792,
      "end_ms": 193426,
      "text": "Нас сейчас раздавит!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "c5b8682a6d264a1d901a25ed7b2d4ed2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 219986,
      "end_ms": 222121,
      "text": "Что... что это за место?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "2cb4fa7b839c459dbad722f215c7ec5e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 222989,
      "end_ms": 223990,
      "text": "Как таверна «Подземный мир»  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "6ca00484f3fb43fca043da59244162c6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 224290,
      "end_ms": 225858,
      "text": "превратилась в Загробный суд?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "0c09a929eb084503a484ef2dde4a250c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 241207,
      "end_ms": 242408,
      "text": "Загробный суд?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "2c9a1a165a26464b851e9463788e1f2d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 242609,
      "end_ms": 243610,
      "text": "Это и правда Загробный суд!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "9cb03c17e2ec4d26a47eef9ffdbdb394",
      "exaggeration": 0.5
    },
    {
      "start_ms": 243977,
      "end_ms": 244811,
      "text": "Эти цепи только что",
      "dub_text": "",
      "character": "командир",
      "cue_id": "f1d8daeba9b64122b8fd7e01abe1a7d1",
      "exaggeration": 0.5
    },
    {
      "start_ms": 244978,
      "end_ms": 246746,
      "text": "так легко приковали призрака А-класса?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "2a40f3f7ecdb48d5a7707ae9fec7a5aa",
      "exaggeration": 0.5
    },
    {
      "start_ms": 246779,
      "end_ms": 249048,
      "text": "Это... настоящий загробный мир?  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "545182927cf043c29603800ddc01ae15",
      "exaggeration": 0.5
    },
    {
      "start_ms": 249549,
      "end_ms": 251651,
      "text": "Оксгрим, Хорсгрим, за работу.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "f44ac31fe6224e65a92cca0641d0a7cb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 252685,
      "end_ms": 254020,
      "text": "Здоровяк у двери выглядит мясистым.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "de032e1941b44b9ba4bbb06d5eba940b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 254020,
      "end_ms": 256389,
      "text": "Поджарьте шашлыки для блюда дня.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "29f94fb7a6b247e484305c9780e79d44",
      "exaggeration": 0.5
    },
    {
      "start_ms": 256589,
      "end_ms": 260360,
      "text": "И хорошенько позаботьтесь о гостях.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "39bcbafaae3441febc8a55824ff4bd6f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 261427,
      "end_ms": 262662,
      "text": "Оксгрим и Хорсгрим?  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "24f503c2ea1a4354b719f656e0350cc0",
      "exaggeration": 0.5
    },
    {
      "start_ms": 264697,
      "end_ms": 266666,
      "text": "Что? Зашкаливают?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "366a6329ef8c406280041dd0d91bc7a3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 266866,
      "end_ms": 268268,
      "text": "Энергия на максимуме!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "a976846f6acc41e1bfa967abbf56b304",
      "exaggeration": 0.5
    },
    {
      "start_ms": 268268,
      "end_ms": 270370,
      "text": "Эти два призрака вне классификации.",
      "dub_text": "",
      "character": "командир",
      "cue_id": "b164af7ef8ba4d00a6c17799295a6b2d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 270536,
      "end_ms": 271571,
      "text": "Класс неизвестен!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "eaf955ee25be4c48920c72f303e2c2db",
      "exaggeration": 0.5
    },
    {
      "start_ms": 271571,
      "end_ms": 272672,
      "text": "Оксгрим и Хорсгрим?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "a4ca617e5998412081e963184163b8e9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 272672,
      "end_ms": 275308,
      "text": "Легендарные жнецы загробного мира.",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "0f59c5ae5662436b8595a68471b52522",
      "exaggeration": 0.5
    },
    {
      "start_ms": 275308,
      "end_ms": 276609,
      "text": "Сначала восстали призраки,",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "aedda54a88e541929a3c4e274192009d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 276609,
      "end_ms": 278611,
      "text": "а теперь и преисподняя стала реальной?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "6e0376de4603488bae8630a4964529c0",
      "exaggeration": 0.5
    },
    {
      "start_ms": 279078,
      "end_ms": 280613,
      "text": "Не убивайте! Я не хочу умирать!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "b32b2fe67db242e28c86b248a5f797d7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 280613,
      "end_ms": 281648,
      "text": "Я ещё даже не женат.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "f3b08ea0d7b14e788fe5102147e0bb30",
      "exaggeration": 0.5
    },
    {
      "start_ms": 281648,
      "end_ms": 283683,
      "text": "Мне семью кормить!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "75cd8a750b3449c18d0eb96010e99da3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 283850,
      "end_ms": 285084,
      "text": "Босс велел",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "960b5973a56e44b2ac37c4fdc6a529c5",
      "exaggeration": 0.5
    },
    {
      "start_ms": 285084,
      "end_ms": 287654,
      "text": "пустить на шашлык того здоровяка  снаружи.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "a71d01701afa4b2480e8308e4f08b82a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 292525,
      "end_ms": 293660,
      "text": "Отправишься в Ад клинков!",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "19cf45d392c44f87ad7ec900604da7b4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 301968,
      "end_ms": 302669,
      "text": "Они пускают  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "f20afb4342b142c69438d405c5405689",
      "exaggeration": 0.5
    },
    {
      "start_ms": 302702,
      "end_ms": 306205,
      "text": "призрака А-класса на шашлыки?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "a318cfe8a9304cae8ab299c5883208aa",
      "exaggeration": 0.5
    },
    {
      "start_ms": 306205,
      "end_ms": 307607,
      "text": "Что это вообще за место?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "d373813d94124dd394b8dc81d653e400",
      "exaggeration": 0.5
    },
    {
      "start_ms": 310943,
      "end_ms": 311311,
      "text": "Бежим!",
      "dub_text": "",
      "character": "командир",
      "cue_id": "466d8fe759c9416fa9612b662d7dd21e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 318851,
      "end_ms": 320253,
      "text": "Выпустите меня!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "93419bb4a15446c6bb56e3105af56967",
      "exaggeration": 0.5
    },
    {
      "start_ms": 321487,
      "end_ms": 323189,
      "text": "Выпустите нас!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "dd054636171b4debb290391d8a7d3a57",
      "exaggeration": 0.5
    },
    {
      "start_ms": 323790,
      "end_ms": 325992,
      "text": "Незваные гости в загробном мире",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "73822be2944940128231968409eb9938",
      "exaggeration": 0.5
    },
    {
      "start_ms": 326626,
      "end_ms": 326826,
      "text": "умрут!",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "d5df6e13e4d84059a7db36ac17d745b9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 328361,
      "end_ms": 330163,
      "text": "Хватит, перестаньте их пугать.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "912a63d7703149a98f4a7e1bdd70d8e4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 330163,
      "end_ms": 332231,
      "text": "Я же велел встретить гостей как следует.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "57d1d5d7d7604bb890fd6d006775077d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 332332,
      "end_ms": 333900,
      "text": "Ещё одна такая выходка,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "27449e1749584d95bb38d529ec82717f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 333933,
      "end_ms": 335902,
      "text": "и пойдёте работать на скотобойню.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2bd707186db54d02ad00614448499bd3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 336736,
      "end_ms": 339772,
      "text": "Босс, свежие шашлыки готовы.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "90f503c3b9d046e6b3b89c7514296bdb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 339972,
      "end_ms": 341040,
      "text": "Как будем готовить?",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "794138c1f9b84279a86e5d6f967caae6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 341274,
      "end_ms": 341641,
      "text": "На гриль.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "5046914eaf594b888da3ebe7990c387d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 342141,
      "end_ms": 342842,
      "text": "Половину с зирой,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "8505df37af924d81869eb72307a1b317",
      "exaggeration": 0.5
    },
    {
      "start_ms": 342842,
      "end_ms": 343576,
      "text": "половину с чили.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "a98c319b111642b3a867ad0eee1334d1",
      "exaggeration": 0.5
    },
    {
      "start_ms": 343576,
      "end_ms": 344277,
      "text": "Ах да,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "047773e9fffa41d38f3f750866974428",
      "exaggeration": 0.5
    },
    {
      "start_ms": 344410,
      "end_ms": 346612,
      "text": "есть особые пожелания?",
      "dub_text": "",
      "character": "гг",
      "cue_id": "57713136d9ef48ae948668cc95ca4bb8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 348181,
      "end_ms": 348648,
      "text": "Есть, босс!",
      "dub_text": "",
      "character": "гг",
      "cue_id": "859e5d4e54ad45cbbebff51764c16499",
      "exaggeration": 0.5
    },
    {
      "start_ms": 350850,
      "end_ms": 351617,
      "text": "назвали его",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "dd84f5c285df4f6fb85b85639030bfba",
      "exaggeration": 0.5
    },
    {
      "start_ms": 351617,
      "end_ms": 352185,
      "text": "боссом?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "b5779932850d4c5aa8e739d747a0eec2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 352251,
      "end_ms": 355321,
      "text": "Эти жуткие призраки работают на него?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "e28d971e50e4491dae2d0823de1b7022",
      "exaggeration": 0.5
    },
    {
      "start_ms": 355321,
      "end_ms": 356322,
      "text": "Прошу прощения.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "cb4ef6c66ff34108807b30860344210d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 356489,
      "end_ms": 358324,
      "text": "У моих сотрудников мало опыта в приёме",
      "dub_text": "",
      "character": "гг",
      "cue_id": "9d2509fd2830489194c58100e96ae99f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 358324,
      "end_ms": 359092,
      "text": " гостей извне.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2f27bd9f473b4b22927c2863e2ce3fc8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 360226,
      "end_ms": 360660,
      "text": "если они вас напугали.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "66929fc95ab1439eae3b7336c2438405",
      "exaggeration": 0.5
    },
    {
      "start_ms": 360893,
      "end_ms": 361861,
      "text": "Позвольте представиться.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "983f7f90b60a4e399ee68ae3ab418e1f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 361861,
      "end_ms": 363363,
      "text": "Добро пожаловать в таверну «Подземный  мир». ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "f390f353fc3f419eb49aa6b305db7f3b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 363363,
      "end_ms": 364864,
      "text": "Я её владелец, Адам Рид",
      "dub_text": "",
      "character": "гг",
      "cue_id": "a4cbc29515414582b5226a3690240143",
      "exaggeration": 0.5
    },
    {
      "start_ms": 365231,
      "end_ms": 366632,
      "text": "Чего желаете?",
      "dub_text": "",
      "character": "гг",
      "cue_id": "b58c84288daf40b0a8b1c3e5ad62ac5a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 366632,
      "end_ms": 367934,
      "text": "Наше фирменное блюдо сегодня —  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "9d6d497ff90e4544bc74d0790d3e07cc",
      "exaggeration": 0.5
    },
    {
      "start_ms": 368267,
      "end_ms": 370803,
      "text": "свежеприготовленный призрак А-класса.  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "28f63be6b3224c448222d4142a70d665",
      "exaggeration": 0.5
    },
    {
      "start_ms": 372271,
      "end_ms": 373206,
      "text": "Два года назад",
      "dub_text": "",
      "character": "гг",
      "cue_id": "80ee9a80469f43a3939886f0c9044a07",
      "exaggeration": 0.5
    },
    {
      "start_ms": 373206,
      "end_ms": 374307,
      "text": "моя мама тяжело заболела.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "5dbb27b947864454af04b2ce034e30fa",
      "exaggeration": 0.5
    },
    {
      "start_ms": 374474,
      "end_ms": 375842,
      "text": "Я дежурил у её постели,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "895bdf8f88fe463ebc0f0465bf5252a6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 375842,
      "end_ms": 377643,
      "text": "как вдруг перенёсся",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0835b461ec5d49b9a1fa103d3a2189b4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 377643,
      "end_ms": 379979,
      "text": "в этот мир, разорённый призраками.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "8013bc778e37483888cd3bae054b556b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 380279,
      "end_ms": 383116,
      "text": "Но я не стал Стражем, как остальные.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "448c929e564341d6a12bf4c8dc42e3f2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 383116,
      "end_ms": 385084,
      "text": "И суперспособностей у меня не появилось.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2b537524d6ae479085ab8878d6af87ab",
      "exaggeration": 0.5
    },
    {
      "start_ms": 386953,
      "end_ms": 387920,
      "text": "Адам!",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "90c5697d1c594ad4b99c346b6574fb6b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 387920,
      "end_ms": 388521,
      "text": "Ах ты ничтожество!",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "fd608ecb924a4774ac4035bdf84687cf",
      "exaggeration": 0.5
    },
    {
      "start_ms": 391090,
      "end_ms": 393025,
      "text": "а не помойка для каждой",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "7542f6f0b7ef4cb4a75ea5144032854e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 393025,
      "end_ms": 394160,
      "text": "бездомной псины!",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "5fcb34e2dfd34485969099bff43ea783",
      "exaggeration": 0.5
    },
    {
      "start_ms": 394227,
      "end_ms": 395428,
      "text": "Такой бездарности, как ты,",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "ec907f790bd94bb7b4fb621b896e7ef7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 395428,
      "end_ms": 395962,
      "text": "не место здесь! Я лежал",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "a393831698f2429c8d35186b47f46c8e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 396062,
      "end_ms": 398131,
      "text": "Хватит тратить ресурсы! — в грязи,",
      "dub_text": "",
      "character": "головний бази Скайка",
      "cue_id": "bf8f75232f1f4231b5c3785e1d214fb1",
      "exaggeration": 0.5
    },
    {
      "start_ms": 398197,
      "end_ms": 399265,
      "text": "Пошёл вон! думая, что это конец.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "4fcbecc13fe942169959342583010f6a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 399899,
      "end_ms": 402034,
      "text": "Я больше не вернусь в свой мир.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "39685a41020d4483bc5ee77c1195631a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 402101,
      "end_ms": 404203,
      "text": "Никогда не увижу больную маму.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "9cc684e1e3164704aba3ddc52d9dd5ce",
      "exaggeration": 0.5
    },
    {
      "start_ms": 404370,
      "end_ms": 406305,
      "text": "И вот, на самом дне отчаяния,  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "1e0ceb5107f44425b7924454d8e23450",
      "exaggeration": 0.5
    },
    {
      "start_ms": 406305,
      "end_ms": 407707,
      "text": "я услышал услышал голос.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "d2a0df120eed4957be8fc65e7d294a1f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 407774,
      "end_ms": 409776,
      "text": "Активация Системы Подземного мира.  ",
      "dub_text": "",
      "character": "система",
      "cue_id": "10dcf57e447747e8a3d994852946d8ad",
      "exaggeration": 0.5
    },
    {
      "start_ms": 409776,
      "end_ms": 412211,
      "text": "Вы получили набор новичка:",
      "dub_text": "",
      "character": "система",
      "cue_id": "07a210243193442e98ac296ed9bba436",
      "exaggeration": 0.5
    },
    {
      "start_ms": 412211,
      "end_ms": 413813,
      "text": "одну таверну «Подземный мир».",
      "dub_text": "",
      "character": "система",
      "cue_id": "028cb79968914793818d6055bc22444a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 414847,
      "end_ms": 416115,
      "text": "С того самого дня",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0ce95c0655cd4396a8371316bfa92c52",
      "exaggeration": 0.5
    },
    {
      "start_ms": 416115,
      "end_ms": 417850,
      "text": "я управляю Подземным миром Пустоши",
      "dub_text": "",
      "character": "гг",
      "cue_id": "38b2e1b8bb4a4acaa930b5ea0d88c375",
      "exaggeration": 0.5
    },
    {
      "start_ms": 418151,
      "end_ms": 420052,
      "text": "и таверной «Подземный мир».",
      "dub_text": "",
      "character": "гг",
      "cue_id": "88596a891a344f7ebedf0eecf07c0fcc",
      "exaggeration": 0.5
    },
    {
      "start_ms": 420353,
      "end_ms": 421721,
      "text": "С помощью системы переработки",
      "dub_text": "",
      "character": "гг",
      "cue_id": "125d5760cc9d4ec9a0c52596f11c6651",
      "exaggeration": 0.5
    },
    {
      "start_ms": 421788,
      "end_ms": 424824,
      "text": "я пускаю призраков на свежее мясо.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "4830c8d03e284bd4b2b529e71b395718",
      "exaggeration": 0.5
    },
    {
      "start_ms": 424891,
      "end_ms": 426726,
      "text": "Если заработаю достаточно монет,  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "885b4c98328340c496658cd7bd5750f3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 426793,
      "end_ms": 428261,
      "text": "смогу улучшить свои заведения.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "d0eb6291c8b244ee90a41913b145e6d9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 428327,
      "end_ms": 430863,
      "text": "А когда стану Владыкой Подземного мира,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "5a4d45bb3fe7464aa1fe07bb9a06cd2f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 431431,
      "end_ms": 432732,
      "text": "открою портал между мирами,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "3dbb668bba204c49a9bb45020006aff8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 432765,
      "end_ms": 433666,
      "text": "вернусь домой",
      "dub_text": "",
      "character": "гг",
      "cue_id": "c82e668e74174a21b38d7c0ea2e89e05",
      "exaggeration": 0.5
    },
    {
      "start_ms": 435968,
      "end_ms": 436402,
      "text": "и спасу маму.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "463aaacf54a84fbebf980c8a5901234e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 437904,
      "end_ms": 439539,
      "text": "Текущий ранг: Клерк Подземного мира.",
      "dub_text": "",
      "character": "система",
      "cue_id": "bbe8b9b58846430281cf10be681ac5f3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 439672,
      "end_ms": 443843,
      "text": "Активы: таверна «Подземный мир» 1-го  уровня.",
      "dub_text": "",
      "character": "система",
      "cue_id": "e010c8e2f2874e5280f4d66080c3e2eb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 443843,
      "end_ms": 444777,
      "text": "Баланс призрачных монет: 48.",
      "dub_text": "",
      "character": "система",
      "cue_id": "9b1119851ec4442c94f57c0fdc42645e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 444844,
      "end_ms": 447780,
      "text": "Новый объект — Фруктовая лавка,",
      "dub_text": "",
      "character": "система",
      "cue_id": "da3fc121b7204840b980361d8cd03575",
      "exaggeration": 0.5
    },
    {
      "start_ms": 447780,
      "end_ms": 449315,
      "text": "стоит 100 000 призрачных монет.",
      "dub_text": "",
      "character": "система",
      "cue_id": "f239c0d29a7d4da395029367f3487146",
      "exaggeration": 0.5
    },
    {
      "start_ms": 449315,
      "end_ms": 452618,
      "text": "Ранг повысится до Патрульного  Преисподней,",
      "dub_text": "",
      "character": "система",
      "cue_id": "b943cdfb513d4dcbb09ddbcc6f8f0c31",
      "exaggeration": 0.5
    },
    {
      "start_ms": 452618,
      "end_ms": 453653,
      "text": "и появятся новые сотрудники:",
      "dub_text": "",
      "character": "система",
      "cue_id": "40cc47a3c9d04d1c8291c7ca856856ad",
      "exaggeration": 0.5
    },
    {
      "start_ms": 453653,
      "end_ms": 454620,
      "text": "Чёрное и Белое Непостоянство.",
      "dub_text": "",
      "character": "система",
      "cue_id": "43178f28448b4c60b7d322a01fa104cc",
      "exaggeration": 0.5
    },
    {
      "start_ms": 455421,
      "end_ms": 457523,
      "text": "Пришлось призвать Оксгрима и  Хорсгрима,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2c096736fe7b442797e1215b6f29ffa7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 457523,
      "end_ms": 458991,
      "text": "чтобы одолеть призрака Чёрного Козла.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "c670a6b63a124d1a9a5a3feb15fc616c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 459025,
      "end_ms": 460827,
      "text": "Это влетело мне в копеечку.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "47dc950cca124557b49825d2633a56a7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 460860,
      "end_ms": 462261,
      "text": "Теперь я вообще на мели.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0f8eebcc65b84a6d804a777b1a59394d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 462328,
      "end_ms": 464664,
      "text": "Надо стрясти с этих троих толстосумов",
      "dub_text": "",
      "character": "гг",
      "cue_id": "dd3571937c4e42de9a9c274efc3e6ca2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 464664,
      "end_ms": 465832,
      "text": "всё до последней монетки.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "2a30d48d21de4f9db7c6193815f88397",
      "exaggeration": 0.5
    },
    {
      "start_ms": 465898,
      "end_ms": 467767,
      "text": "Иначе со своими 48 монетами",
      "dub_text": "",
      "character": "гг",
      "cue_id": "ebbb9b6e152d446dbc9e64a256a91263",
      "exaggeration": 0.5
    },
    {
      "start_ms": 467800,
      "end_ms": 470369,
      "text": "я никогда не накоплю 100 000  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "018ca9fd02564ca99e5227892f99e494",
      "exaggeration": 0.5
    },
    {
      "start_ms": 470369,
      "end_ms": 471400,
      "text": "на эту фруктовую лавку.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "65fba9f1e8ce42959a67b106b55187eb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 471600,
      "end_ms": 473105,
      "text": "Чего же вы стоите, ребят?",
      "dub_text": "",
      "character": "гг",
      "cue_id": "fe984c06f4744bb688f2640de97a488c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 473940,
      "end_ms": 474941,
      "text": "Кажется, я вас напугал.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "d6d27a22b63b41b6b2a77215309c4777",
      "exaggeration": 0.5
    },
    {
      "start_ms": 475200,
      "end_ms": 475842,
      "text": "Давайте так: ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "70a18c7129a94ffe91dcb21fccca94f4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 476042,
      "end_ms": 477343,
      "text": "в качестве извинения зайдёте перекусить?  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0cde7f016e7c4aee8802a92d878f6ce2",
      "exaggeration": 0.5
    },
    {
      "start_ms": 477610,
      "end_ms": 478544,
      "text": "Я сам вас обслужу.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "4499a4fcacb749f4982ec1cde686c6f7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 478578,
      "end_ms": 480313,
      "text": "Перекусить?  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "e6051d50de704341b769f0fbd8454276",
      "exaggeration": 0.5
    },
    {
      "start_ms": 480313,
      "end_ms": 480880,
      "text": "Именно.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "6325f7a282bb4155814d060ac97adb16",
      "exaggeration": 0.5
    },
    {
      "start_ms": 480947,
      "end_ms": 483349,
      "text": "Помимо ночлега и горячей еды,  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "982e3e00738e44bd8282db5266d24126",
      "exaggeration": 0.5
    },
    {
      "start_ms": 483500,
      "end_ms": 484784,
      "text": "мы также продаём свежие овощи.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "68a6cab72ebc41b2a088bd29058ec7fc",
      "exaggeration": 0.5
    },
    {
      "start_ms": 484951,
      "end_ms": 487053,
      "text": "А сегодня у нас фирменное барбекю.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "953a2b1188334134b7d9fe1eaad0a4ed",
      "exaggeration": 0.5
    },
    {
      "start_ms": 487053,
      "end_ms": 488521,
      "text": "Там, в Пустоши,  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "f5973caa2de542098ee266d571d74e3e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 488521,
      "end_ms": 490590,
      "text": "вы такого точно не найдёте.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "148484cda57c4eb0af40d6b4d028bdd6",
      "exaggeration": 0.5
    },
    {
      "start_ms": 490690,
      "end_ms": 491858,
      "text": "С какой вы базы?",
      "dub_text": "",
      "character": "гг",
      "cue_id": "fb3cb8fc6b5441ffbe273e9a10187eeb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 491891,
      "end_ms": 493493,
      "text": "Судя по снаряжению и рангу,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "d398abc3e8494ac994cfd30ced4a8d90",
      "exaggeration": 0.5
    },
    {
      "start_ms": 493493,
      "end_ms": 494694,
      "text": "вы не из простого места.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "279d00ea8647412f97712bd33d3ae1e0",
      "exaggeration": 0.5
    },
    {
      "start_ms": 494727,
      "end_ms": 497363,
      "text": "Мы... мы с базы «Ковчег».",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "721e4c85dc334f87a78a36e232f71a06",
      "exaggeration": 0.5
    },
    {
      "start_ms": 497430,
      "end_ms": 499165,
      "text": "Это база В-класса.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "df624adc730940ab925f35b27bdbc42e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 499232,
      "end_ms": 501767,
      "text": "Босс, шашлычки готовы.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "290acb5d30184a9da113d818d2f87335",
      "exaggeration": 0.5
    },
    {
      "start_ms": 501900,
      "end_ms": 504670,
      "text": "Вся скверна и негативная энергия",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "435c60a027a043799be45a07859f92bf",
      "exaggeration": 0.5
    },
    {
      "start_ms": 504800,
      "end_ms": 506372,
      "text": "полностью удалены.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "80799d1d501945ccb762ef7d862d8922",
      "exaggeration": 0.5
    },
    {
      "start_ms": 506405,
      "end_ms": 508207,
      "text": "Вырезка - самая нежная часть.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "694de854ac7a452ca7519f36386f2b1b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 508400,
      "end_ms": 509475,
      "text": "Идеально для жарки.",
      "dub_text": "",
      "character": "прислужник",
      "cue_id": "60d8d0944134410495c40548f034de39",
      "exaggeration": 0.5
    },
    {
      "start_ms": 509709,
      "end_ms": 512745,
      "text": "Это из того жуткого Чёрного Козла?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "2d2746d250f14dac99477b0110913bbc",
      "exaggeration": 0.5
    },
    {
      "start_ms": 512945,
      "end_ms": 515348,
      "text": "Разве мясо призраков так пахнет?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "63cb5297509f4f5f973c1acf93158849",
      "exaggeration": 0.5
    },
    {
      "start_ms": 515448,
      "end_ms": 517049,
      "text": "Аж слюнки потекли от запаха!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "0f68d755c8184b289fc43d96ec41428b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 517049,
      "end_ms": 519619,
      "text": "Господин, простите за вопрос, но",
      "dub_text": "",
      "character": "командир",
      "cue_id": "ffa974d1c45b4b43821107aef101f046",
      "exaggeration": 0.5
    },
    {
      "start_ms": 519819,
      "end_ms": 521687,
      "text": "вы Патрульный Ѕ-класса?",
      "dub_text": "",
      "character": "командир",
      "cue_id": "995aaa78cc5d4f6c93f4dfeb6865cd12",
      "exaggeration": 0.5
    },
    {
      "start_ms": 521721,
      "end_ms": 522722,
      "text": "Насколько я знаю,  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "c34cc117d2884ec7a7a888f587607b80",
      "exaggeration": 0.5
    },
    {
      "start_ms": 522722,
      "end_ms": 524891,
      "text": "даже лучшие Патрульные Ѕ-класса  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "e5fa125dc0464fc89c2b64c0baa21531",
      "exaggeration": 0.5
    },
    {
      "start_ms": 524924,
      "end_ms": 527927,
      "text": "не подчинят внеклассовых призраков.  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "156f35c31abf410794509bdd27807c5b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 527927,
      "end_ms": 529262,
      "text": "Я? Патрульный?  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "7c247387e7ca4f699de26cd371971910",
      "exaggeration": 0.5
    },
    {
      "start_ms": 529762,
      "end_ms": 530029,
      "text": "Вы мне льстите.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "7cabbcdba5104167bbf0b86166936ccf",
      "exaggeration": 0.5
    },
    {
      "start_ms": 531130,
      "end_ms": 532131,
      "text": "Я самый обычный человек.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "4545e87685004ebfa9a09422cf2a26e3",
      "exaggeration": 0.5
    },
    {
      "start_ms": 532131,
      "end_ms": 533366,
      "text": "Никаких суперсил.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "282bd9af313e4cb0b10f4bf5de8f32b9",
      "exaggeration": 0.5
    },
    {
      "start_ms": 533533,
      "end_ms": 535935,
      "text": "Обычный? Так я и поверил!  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "75052b586e4044fd822accf8addb77d7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 536202,
      "end_ms": 538771,
      "text": "У обычного человека жуткие призраки  ",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "f49d157142fe458fa81c910d992b613d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 538771,
      "end_ms": 540573,
      "text": "A сами зовут его боссом? Бред!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "d96399bb1f214ff1b2b4c1ea3d1e6dbb",
      "exaggeration": 0.5
    },
    {
      "start_ms": 540573,
      "end_ms": 541107,
      "text": "Внимание:  ",
      "dub_text": "",
      "character": "система",
      "cue_id": "22c4430a7ac14733b59bbd7e94b76a11",
      "exaggeration": 0.5
    },
    {
      "start_ms": 541107,
      "end_ms": 543743,
      "text": "До открытия фруктовой лавки осталось:  ",
      "dub_text": "",
      "character": "система",
      "cue_id": "921d35291f2c43b491ea728cdd24940d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 543743,
      "end_ms": 544744,
      "text": "  Три месяца.  ",
      "dub_text": "",
      "character": "система",
      "cue_id": "ffa77b8f39cd425db191386a463431e0",
      "exaggeration": 0.5
    },
    {
      "start_ms": 544744,
      "end_ms": 546846,
      "text": "Баланс призрачных монет: 48.",
      "dub_text": "",
      "character": "система",
      "cue_id": "98707b56e38643bf8c549311ad01127d",
      "exaggeration": 0.5
    },
    {
      "start_ms": 546846,
      "end_ms": 547780,
      "text": "Критическая нехватка средств. ",
      "dub_text": "",
      "character": "система",
      "cue_id": "716992fab74148dcaf5e3e8fe5d88e31",
      "exaggeration": 0.5
    },
    {
      "start_ms": 547780,
      "end_ms": 550483,
      "text": "Заработайте монеты для открытия лавки.",
      "dub_text": "",
      "character": "система",
      "cue_id": "798168d7120748528100601deaa42e28",
      "exaggeration": 0.5
    },
    {
      "start_ms": 550550,
      "end_ms": 552652,
      "text": "Иначе вы останетесь здесь навсегда.",
      "dub_text": "",
      "character": "система",
      "cue_id": "c92d0f06c0b74c72be1565a5e4372f3c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 552652,
      "end_ms": 554487,
      "text": "Путь в родной мир будет закрыт.",
      "dub_text": "",
      "character": "система",
      "cue_id": "f60a7f6a0da24be081ed0f21263277be",
      "exaggeration": 0.5
    },
    {
      "start_ms": 555221,
      "end_ms": 556656,
      "text": "Три месяца это мало.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "c74379f62fd14f5a90b8591c50288f7f",
      "exaggeration": 0.5
    },
    {
      "start_ms": 556656,
      "end_ms": 557823,
      "text": "А я всё ещё на мели.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "68747c89e52048cca8de6cff0a96391b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 557823,
      "end_ms": 559659,
      "text": "Надо договориться с этой троицей.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "ed9ba6f3a95c4272a9314c8b1a3a2410",
      "exaggeration": 0.5
    },
    {
      "start_ms": 559692,
      "end_ms": 562128,
      "text": "Нас явно свела сама судьба",
      "dub_text": "",
      "character": "гг",
      "cue_id": "9e4ecb0381054d188c2091774582df52",
      "exaggeration": 0.5
    },
    {
      "start_ms": 562128,
      "end_ms": 562862,
      "text": "здесь, в Пустоши.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "d598f6f881644a53979544b5293f79ee",
      "exaggeration": 0.5
    },
    {
      "start_ms": 562862,
      "end_ms": 564130,
      "text": "Судя по вашему виду,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "3b8ed27327274d67a99bbff528593752",
      "exaggeration": 0.5
    },
    {
      "start_ms": 564130,
      "end_ms": 566666,
      "text": "с припасами у вас туго, да?",
      "dub_text": "",
      "character": "гг",
      "cue_id": "71712f8f7d5248ffbb2138cc28dcad68",
      "exaggeration": 0.5
    },
    {
      "start_ms": 566666,
      "end_ms": 567900,
      "text": "Туго? Не то слово.",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "2e7e72c83b26404db120c78d9179bf28",
      "exaggeration": 0.5
    },
    {
      "start_ms": 567967,
      "end_ms": 568601,
      "text": "Это настоящий кошмар!",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "f27afb3cc37245b48984626af842a4bd",
      "exaggeration": 0.5
    },
    {
      "start_ms": 569669,
      "end_ms": 569969,
      "text": "С тех пор как восстали призраки,",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "783a32996fb3464282d59c937a539846",
      "exaggeration": 0.5
    },
    {
      "start_ms": 571904,
      "end_ms": 572872,
      "text": "Я за всю свою жизнь",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "04d1c66b32124aa3a0e1512a4e5353c8",
      "exaggeration": 0.5
    },
    {
      "start_ms": 572872,
      "end_ms": 574941,
      "text": "не видел настоящего свежего мяса.",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "1b3ab7261f274e0c9ba29ca2858d9542",
      "exaggeration": 0.5
    },
    {
      "start_ms": 574941,
      "end_ms": 576576,
      "text": "Тогда вам повезло.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "01d292a82a154920ac6864a413b956d7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 576576,
      "end_ms": 578311,
      "text": "Были бы деньги,",
      "dub_text": "",
      "character": "гг",
      "cue_id": "3dac4109309d4352bb097a4d8b1f0e3b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 578344,
      "end_ms": 579712,
      "text": "а здесь найдётся всё.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "89cc282c46614fb2b0dd36d999a0d35c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 579712,
      "end_ms": 583182,
      "text": "Свежее мясо, закуски, напитки.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "1175e2c6595a4810ba3c868a9a638972",
      "exaggeration": 0.5
    },
    {
      "start_ms": 583282,
      "end_ms": 584617,
      "text": "Но одно мясо быстро надоест.",
      "dub_text": "",
      "character": "гг",
      "cue_id": "21fb2eaa145e4fa1bcfa6cc4527bdec4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 584617,
      "end_ms": 586385,
      "text": "Поэтому позвольте представить  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "187b191cef3344afa1ca431029747724",
      "exaggeration": 0.5
    },
    {
      "start_ms": 586485,
      "end_ms": 588421,
      "text": "ещё одну гордость этой таверны:  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "5a22760d8e454bb69511ceb7a84ed481",
      "exaggeration": 0.5
    },
    {
      "start_ms": 588588,
      "end_ms": 589989,
      "text": "овощную ферму Подземного мира.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "066e26c49ace4ea891aa24e1e6cb73d7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 594060,
      "end_ms": 595728,
      "text": "Это что, картошка?  ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "13f8df43dc014e28816dcec81a3b981b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 596128,
      "end_ms": 596395,
      "text": "Хотите сказать, чипсы",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "400924fc6bb0410cb81e914f194530e4",
      "exaggeration": 0.5
    },
    {
      "start_ms": 597430,
      "end_ms": 597897,
      "text": "ваших полках ",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "405868a0c90147f3bdeb66f1abba2d75",
      "exaggeration": 0.5
    },
    {
      "start_ms": 598130,
      "end_ms": 599565,
      "text": "из этой свежей картошки?",
      "dub_text": "",
      "character": "Біло волоса",
      "cue_id": "eea2d300c06f403785946b88a2dac3f1",
      "exaggeration": 0.5
    },
    {
      "start_ms": 601968,
      "end_ms": 602902,
      "text": "А эти помидоры  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "aa52ddedee9440de92f7e42eab967515",
      "exaggeration": 0.5
    },
    {
      "start_ms": 602902,
      "end_ms": 605738,
      "text": "вообще не похожи на образцы,",
      "dub_text": "",
      "character": "командир",
      "cue_id": "e032ea3908d948329696fd541c79533a",
      "exaggeration": 0.5
    },
    {
      "start_ms": 605738,
      "end_ms": 606739,
      "text": "что я видел на базе S-класса.",
      "dub_text": "",
      "character": "командир",
      "cue_id": "5bb62e7b96554204970d5e7e12edd95c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 607039,
      "end_ms": 607974,
      "text": "Такие огромные и красные.  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "0b91bdfc79624c829d80cb17cd03d1ed",
      "exaggeration": 0.5
    },
    {
      "start_ms": 607974,
      "end_ms": 609642,
      "text": "Ещё и пахнут фруктами.  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "be2c78d8091d448bbc9c4e3ad4811537",
      "exaggeration": 0.5
    },
    {
      "start_ms": 610109,
      "end_ms": 613579,
      "text": "Это реально свежие овощи?  ",
      "dub_text": "",
      "character": "командир",
      "cue_id": "fbe54a818fd24192a75356844c80e357",
      "exaggeration": 0.5
    },
    {
      "start_ms": 616148,
      "end_ms": 617483,
      "text": "на картинках в архивах.",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "47eed87a27244917b5e426b044204d8c",
      "exaggeration": 0.5
    },
    {
      "start_ms": 617650,
      "end_ms": 619552,
      "text": "Не думал, что увижу их вживую!",
      "dub_text": "",
      "character": "нитік",
      "cue_id": "39133c6debab4d40a5ffad11f562144b",
      "exaggeration": 0.5
    },
    {
      "start_ms": 619952,
      "end_ms": 622121,
      "text": "Почему бы вам их не попробовать?  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0df947219c26446ca51c7af5659a7bbf",
      "exaggeration": 0.5
    },
    {
      "start_ms": 622121,
      "end_ms": 623089,
      "text": "Я приготовлю вам  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "30699ad84cea4d0ca9bc1112b812dee7",
      "exaggeration": 0.5
    },
    {
      "start_ms": 623489,
      "end_ms": 626125,
      "text": "нормальное блюдо из свежих продуктов.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "3c55126d8f794b20a31115569612467e",
      "exaggeration": 0.5
    },
    {
      "start_ms": 626192,
      "end_ms": 627360,
      "text": "Попробуйте, а потом  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "0e58066891bf45338da440c274c05999",
      "exaggeration": 0.5
    },
    {
      "start_ms": 627360,
      "end_ms": 630329,
      "text": "решайте, покупать ли у нас припасы.  ",
      "dub_text": "",
      "character": "гг",
      "cue_id": "ffe837d3562c4fb180afba225e875683",
      "exaggeration": 0.5
    },
    {
      "start_ms": 62900,
      "end_ms": 63200,
      "text": "Чорт",
      "dub_text": "Чорт",
      "character": "командир",
      "cue_id": "31ef46db74f345d9ac74082bd7df8828",
      "exaggeration": 0.5
    }
  ],
